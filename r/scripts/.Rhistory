correlacao = cor(tabela[[coluna]], tabela$exam_score,method = "pearson")
# Loop para cada coluna
for(coluna in numericas) {
# Calcular correlação
correlacao <- cor(tabela[[coluna]], tabela$exam_score, method = "pearson")
print(paste(coluna, ":", round(correlacao, 4)))
# Criar gráfico
p <- ggplot(tabela, aes(x = .data[[coluna]], y = exam_score)) +
geom_point(alpha = 0.4, size = 2) +
geom_smooth(method = "lm", se = TRUE, color = "red") +
labs(title = paste(coluna, "vs Exam Score"),
subtitle = paste("Correlação: r =", round(correlacao, 3)),
x = coluna,
y = "Exam Score") +
theme_minimal()
# Mostrar gráfico
print(p)
}
library(ggplot2)
numericas = c("study_hours", "class_attendance", "sleep_hours")
