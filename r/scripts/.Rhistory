#Importando os dados
tabela = read.csv("../../data/Exam_Score_Prediction.csv")
head(tabela,10)
modelo = lm(exam_score ~ age + study_hours + class_attendance + sleep_hours, data = tabela)
summary(modelo)
library(ggplot2)
summary(modelo)
hist(tabela)
hist(tabela, xlab = "exam_score"
)
ggplot(tabela, aes(x = exam_score)) + geom_histogram()
ggplot(tabela, aes(x = exam_score)) + geom_point()
ggplot(tabela, aes(x = x, y = y)) + geom_point()
ggplot(tabela, aes(x = study_hours, y = exam_score)) + geom_point()
ggplot(tabela, aes(x = study_hours, y = exam_score)) + geom_point(color = "blue", size = 3)
ggplot(tabela, aes(x = study_hours, y = exam_score)) + geom_point(color = "blue", size = 1)
ggplot(tabela, aes(x = study_hours, y = exam_score)) + geom_point(color = "blue", size = 0.5)
ggplot(tabela, aes(x = study_hours, y = exam_score)) + geom_point(color = "blue", size = 0.5, alpha = 0.5)
ggplot(tabela, aes(x = study_hours, y = exam_score)) + geom_point(color = "blue", size = 0.5, alpha = 0.2)
ggplot(tabela, aes(x = study_hours, y = exam_score)) +
geom_point(color = "blue", size = 0.5, alpha = 0.2) +
geom_smooth(method = "lm")
cor(tabela$study_hours, tabela$exam_score)
